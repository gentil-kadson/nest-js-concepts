@baseUrl = http://localhost:3000

# RECADOS
### Lista todos os recados
GET {{baseUrl}}/recados/
?limit=200
&offset=230

### Lista apenas um recado
GET {{baseUrl}}/recados/2/

### Cria um recado
POST {{baseUrl}}/recados/
Content-Type: application/json

{
    "texto": "4 NOVO Recado",
    "de": "Joana",
    "para": "João",
    "lido": false,
    "data": "2026-10-19T17:59:20.246Z"
}

### Atualiza um recado
PATCH {{baseUrl}}/recados/2/
Content-Type: application/json

{
    "texto": "ATUALIZAR Recado",
    "de": "Joana",
    "para": "João",
    "lido": false,
    "data": "2026-10-19T17:59:20.246Z"
}

### Apaga um recado
DELETE {{baseUrl}}/recados/2/


